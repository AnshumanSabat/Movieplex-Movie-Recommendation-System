<div id="toastContainer" class="fixed bottom-6 right-30 z-50 flex flex-col gap-2"></div>




    <script>
      const carousel = document.getElementById("carousel");
      const carousel2 = document.getElementById("carousel2");
      const carousel3 = document.getElementById("carousel3");

setInterval(() => {
    if (carousel.scrollLeft >= carousel.scrollWidth - carousel.clientWidth) {
        carousel.scrollLeft = 0;
    } else {
        carousel.scrollLeft += 320;
    }
}, 3000);
setInterval(() => {
    if (carousel2.scrollLeft >= carousel2.scrollWidth - carousel2.clientWidth) {
        carousel2.scrollLeft = 0;
    } else {
        carousel2.scrollLeft += 320;
    }
}, 3000);
setInterval(() => {
    if (carousel3.scrollLeft >= carousel3.scrollWidth - carousel3.clientWidth) {
        carousel3.scrollLeft = 0;
    } else {
        carousel3.scrollLeft += 320;
    }
}, 3000);
                let asis = document.getElementById("asis");
                let asisbox = document.getElementById("asisbox");
                let prof = document.getElementById("prof");
                let probtn = document.getElementById("profbtn");
                const themeToggle = document.getElementById('themeToggle');
          asis.onclick = function(e){
  e.stopPropagation();
  asisbox.classList.toggle("hidden");
}


if (probtn) {
  probtn.onclick = function(e){
    e.stopPropagation();
    prof.classList.toggle("hidden");
  }
}

document.addEventListener('click', (e) => {
  if (asisbox && !asisbox.contains(e.target)) {
    asisbox.classList.add('hidden');
  }
  if (prof && !prof.contains(e.target)) {
    prof.classList.add('hidden');
  }
});


if (localStorage.getItem('theme') === 'light') {
  document.documentElement.classList.add('light');
}

themeToggle.onclick = function() {
  document.documentElement.classList.toggle('light');
  localStorage.setItem('theme', document.documentElement.classList.contains('light') ? 'light' : 'dark');
  showToast('Theme changed!');
};
function showToast(message) {
  const container = document.getElementById('toastContainer');
  const toast = document.createElement('div');
  toast.textContent = message;
  toast.className = "bg-surface border border-border text-text px-4 py-2 rounded-lg shadow-lg";
  container.appendChild(toast);
  setTimeout(() => toast.remove(), 2000);
}
                </script>

