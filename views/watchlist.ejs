<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MoviePlex</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

<link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" />
    
    <style type="text/tailwindcss">
@theme {
    --color-page: #0D1117;
    --color-surface: #161B22;
    --color-hover: #21262D;
    --color-border: #30363D;
    --color-accent: #2F81F7;
    --color-accent-hover: #1F6FEB;
    --color-text: #E6EDF3;
    --color-muted: #8B949E;
    --color-subtle: #6E7681;
    --color-done: #3FB950;
    --color-danger: #F85149;
    --color-pin: #E3B341;
    --color-pin-hover: #D29922;
    --color-show: #58A6FF;
    --color-show-hover: #79C0FF;
}
.light {
    --color-page: #F7F8FA;
    --color-surface: #FFFFFF;
    --color-hover: #EDEFF2;
    --color-border: #D8DCE2;
    --color-text: #0D1117;
    --color-muted: #57606A;
    --color-subtle: #6E7681;
    --color-done: #1A7F37;
    --color-danger: #CF222E;
    --color-pin: #9A6700;
    --color-pin-hover: #7A5200;
    --color-show: #0969DA;
    --color-show-hover: #0550AE;
}
</style>
<style>
.hide-scrollbar::-webkit-scrollbar{
    display:none;
}

.hide-scrollbar{
    -ms-overflow-style:none;
    scrollbar-width:none;
}
    </style>
</head>
<body class="min-h-screen bg-page text-text ">

    
   <div class="relative min-h-screen bg-page text-text">
  <input id="my-drawer-4" type="checkbox" class="peer hidden" />

  
<nav class="sticky top-0 z-50 bg-surface border-b border-border">

  <div class="flex items-center justify-between gap-3 px-4 py-2">

    <div class="flex items-center gap-3 shrink-0">
      <label
        for="my-drawer-4"
        class="cursor-pointer border rounded-lg border-border p-2 hover:bg-hover transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
          stroke-linejoin="round"
          stroke-linecap="round"
          stroke-width="2"
          fill="none"
          stroke="currentColor"
          class="size-5 text-purple-600">
          <path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path>
          <path d="M9 4v16"></path>
          <path d="M14 10l2 2l-2 2"></path>
        </svg>
      </label>

      <a href="/" class="flex items-center gap-2 shrink-0">
        <img
          src="/gifs/screen_hive_loader.gif"
          class="w-11 h-11 rounded-lg object-cover"
        >
        <h1 class=" md:block text-lg font-semibold">
          Movieplex
        </h1>
      </a>
    </div>

    <div class="hidden md:flex flex-1 px-8">
      <form action="/search" method="GET" class="relative w-full max-w-md mx-auto">
        <input
          type="search"
          name="q"
          placeholder="Search movies, shows..."
          class="w-full rounded-full border border-border bg-page px-4 py-2 pr-10 text-text placeholder-subtle focus:outline-none focus:border-purple-600 focus:ring-1 focus:ring-purple-600"
        >

        <button
          type="submit"
          class="absolute right-1 top-1/2 -translate-y-1/2 p-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="size-4 text-purple-600">
            <circle cx="10" cy="10" r="7"></circle>
            <path d="M21 21l-6 -6"></path>
          </svg>
        </button>
      </form>
    </div>

    <div class="shrink-0">
      <% if(user){ %>
        <% if(user.image){ %>
          <img
            src="<%=user.image%>"
            class="h-10 w-10 rounded-full outline outline-green-600 object-cover"
          >
        <% } else { %>
          <img
            src="/images/default-avatar.png"
            class="h-10 w-10 rounded-full outline outline-green-600 object-cover"
          >
        <% } %>
      <% } else { %>
        <a
          href="/login"
          class="px-3 py-2 rounded-lg hover:bg-purple-600"
        >
          Login
        </a>
      <% } %>
    </div>

  </div>

  <div class="px-4 pb-3 md:hidden">
    <form action="/search" method="GET" class="relative">
      <input
        type="search"
        name="q"
        placeholder="Search movies, shows..."
        class="w-full rounded-full border border-border bg-page px-4 py-2 pr-10 text-text placeholder-subtle focus:outline-none focus:border-purple-600 focus:ring-1 focus:ring-purple-600"
      >

      <button
        type="submit"
        class="absolute right-1 top-1/2 -translate-y-1/2 p-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="size-4 text-purple-600">
          <circle cx="10" cy="10" r="7"></circle>
          <path d="M21 21l-6 -6"></path>
        </svg>
      </button>
    </form>
  </div>

</nav>


   <label for="my-drawer-4" class="fixed inset-0 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none peer-checked:opacity-100 peer-checked:pointer-events-auto transition-opacity duration-300 z-40"></label>

<div class="fixed left-0 top-0 z-50 h-full w-64 -translate-x-full peer-checked:translate-x-0 transition-transform duration-300 ease-in-out bg-surface border-r border-border flex flex-col shadow-2xl">
  <ul class="menu w-full grow p-3 mt-20 gap-1">
    <li>
      <a href="/" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-semibold text-text/90 hover:bg-purple-600/15 hover:text-purple-400 transition-all duration-200">
        <i data-lucide="house" class="size-5"></i> <span>Home</span>
      </a>
    </li>
    <li>
      <a href="/watchlist" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-semibold text-text/90 hover:bg-purple-600/15 hover:text-purple-400 transition-all duration-200">
        <i data-lucide="bookmark" class="size-5"></i> <span>Watchlist</span>
      </a>
    </li>
    <li>
      <button id="themeToggle" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl font-semibold text-text/90 hover:bg-purple-600/15 hover:text-purple-400 transition-all duration-200">
        <i data-lucide="sun-moon" class="size-5"></i> <span>Theme</span>
      </button>
    </li>
    <li>
      <a href="/settings" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-semibold text-text/90 hover:bg-purple-600/15 hover:text-purple-400 transition-all duration-200">
        <i data-lucide="settings" class="size-5"></i> <span>Settings</span>
      </a>
    </li>
    <li>
      <a href="/help" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-semibold text-text/90 hover:bg-purple-600/15 hover:text-purple-400 transition-all duration-200">
        <i data-lucide="circle-help" class="size-5"></i> <span>Help</span>
      </a>
    </li>
  </ul>

  <div class="p-3 border-t border-border">
    <%if(user){%>
      <% if(user.image){ %>
        <div class="flex items-center gap-2 px-2 py-2">
          <img src="<%= user.image %>" class="outline outline-green-600 h-8 w-8 rounded-full object-cover">
          <span class="text-text font-bold text-sm tracking-tighter truncate"><%=user.name || user.username%></span>
        </div>
      <% } else { %>
        <div class="flex items-center gap-2 px-2 py-2">
          <img src="/images/default-avatar.png" class="outline outline-green-600 h-8 w-8 rounded-full object-cover">
          <span class="text-text font-bold text-sm tracking-tighter truncate"><%=user.name || user.username%></span>
        </div>
      <% } %>

      <a href="/logout" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-semibold text-danger hover:bg-danger/15 transition-all duration-200">
        <i data-lucide="log-out" class="size-5"></i> <span>Logout</span>
      </a>
      <%}else{%>
        <a href="/login" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-semibold text-blue-500 hover:bg-blue-500/15 transition-all duration-200">
          <i data-lucide="log-in" class="size-5"></i> <span>Login</span>
        </a>
       <%}%>
    
  </div>
</div>

<button id="asis" class="fixed bottom-6 right-6 z-40 rounded-full shadow-xl shadow-purple-900/40 hover:scale-110 transition-all duration-300 group">
  <img src="/gifs/ai_assistant_clapper_purple.gif" class="object-center rounded-full h-16 w-16 ring-2 ring-purple-600/60 group-hover:ring-purple-500 transition-all">
</button>

<%if(product){%>
<div id="asisbox" class="flex flex-col fixed top-16 right-4 bottom-28 z-50 bg-surface w-full max-w-sm border border-purple-600/40 rounded-2xl shadow-2xl shadow-purple-900/30 overflow-hidden transition-all duration-300">
<%}else{%>
<div id="asisbox" class="flex flex-col fixed top-16 right-4 bottom-28 z-50 bg-surface w-full max-w-sm border border-purple-600/40 rounded-2xl shadow-2xl shadow-purple-900/30 overflow-hidden transition-all duration-300 hidden">
<%}%>
  <div class="flex items-center justify-between px-4 py-3 bg-gradient-to-r from-purple-900/50 to-surface border-b border-purple-600/30">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-full bg-purple-600/20 flex items-center justify-center">
        <i data-lucide="bot" class="size-4 text-purple-400"></i>
      </div>
      <div>
        <h1 class="text-text font-bold text-sm tracking-tight">Moxie</h1>
        <p class="text-purple-400 text-xs">AI Movie Assistant</p>
      </div>
    </div>
    <button id="asisClose" class="p-1.5 rounded-lg hover:bg-border/50 transition-colors">
      <i data-lucide="x" class="size-4 text-muted"></i>
    </button>
  </div>
  <div class="flex-1 overflow-y-auto px-4 py-4 space-y-3">
    <% if(product){ %>
      <div class="bg-purple-600/10 border border-purple-600/20 rounded-xl p-3">
        <div class="flex items-start gap-2 mb-2">
          <div class="w-6 h-6 rounded-full bg-purple-600/30 flex items-center justify-center shrink-0 mt-0.5">
            <i data-lucide="sparkles" class="size-3 text-purple-400"></i>
          </div>
          <span class="text-xs font-semibold text-purple-400">Moxie</span>
        </div>
        <div class="text-text text-sm leading-relaxed pl-8"><%- product %></div>
      </div>
    <% } else { %>
      <div class="flex flex-col items-center justify-center h-full gap-3 py-8 text-center">
        <div class="w-14 h-14 rounded-full bg-purple-600/10 flex items-center justify-center">
          <i data-lucide="sparkles" class="size-7 text-purple-400/70"></i>
        </div>
        <p class="font-semibold text-text text-sm">Ask me anything about movies!</p>
        <p class="text-muted text-xs max-w-48">I can recommend films, suggest similar titles, and more.</p>
      </div>
    <% } %>
  </div>
  <div class="px-3 py-3 border-t border-border bg-surface/80 backdrop-blur-sm">
    <div class="flex items-center gap-2">
      <form class="flex flex-1 items-center gap-2 bg-page rounded-xl border border-border focus-within:border-purple-600 transition-colors overflow-hidden px-3 py-1.5" method="post" action="/ai">
        <i data-lucide="message-circle" class="size-4 text-muted shrink-0"></i>
        <input name="aiwaladata" class="flex-1 bg-transparent text-sm text-text placeholder:text-muted/60 focus:outline-none py-1" placeholder="Ask about movies...">
        <button type="submit" class="p-1.5 rounded-lg bg-purple-600 hover:bg-purple-700 text-white transition-colors shrink-0">
          <i data-lucide="send" class="size-3.5"></i>
        </button>
      </form>
      <form method="post" action="/clear">
        <button type="submit" title="Clear chat" class="p-2 rounded-xl border border-border hover:bg-danger/10 hover:border-danger/50 text-muted hover:text-danger transition-all">
          <i data-lucide="trash-2" class="size-4"></i>
        </button>
      </form>
    </div>
  </div>
</div>
<%if(movd.length==0){%>
    <h1 class="text-text font-bold text-3xl md:text-4xl text-center tracking-tight italic mb-6 pb-3 border-b-2 border-purple-600/50">Watchlist</h1>
    <h1 class="text-zinc-500 text-2xl text-center">Your watchlist is empty...😿</h1>
    <%}else{%>
    <h1 class="text-text font-bold text-3xl md:text-4xl text-center tracking-tight italic  mb-6 pb-3 border-b-2 border-purple-600/50">Watchlist</h1>
<div class="flex flex-wrap justify-center gap-6 mt-5">

  <% movd.forEach(function(movie){ %>
  <a href="/mdetails/<%=movie.id%>" class="group relative block overflow-hidden rounded-xl border border-border bg-surface w-full max-w-sm">

    <% if(movie.poster_path){ %>
    <img
      alt="<%= movie.title %>"
      src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>"
      class="absolute inset-0 h-full w-full object-cover opacity-80 transition-all duration-300 group-hover:opacity-40 group-hover:scale-105"
    />
    <% } else { %>
    <img
      alt="<%= movie.title %>"
      src="/images/pngtree-no-image-available-icon-flatvector-illustration-pic-design-profile-vector-png-image_40966566.jpg"
      class="absolute inset-0 h-full w-full object-cover opacity-80 transition-all duration-300 group-hover:opacity-40 group-hover:scale-105"
    />
    <% } %>

    <div class=" relative p-4 sm:p-6 lg:p-8">

      <p class="text-sm font-medium tracking-widest uppercase text-accent">
        <% if(movie.vote_average == 0){ %>Not Rated yet<% } else { %>⭐ <%=movie.vote_average.toFixed(1)%><% } %>
      </p>

      <p class="text-xl font-bold text-text sm:text-2xl italic">
        <%= movie.title %>
      </p>

      <div class="mt-32 sm:mt-30 lg:mt-54">
        <div class="translate-y-8 opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
          <p class="text-sm text-muted line-clamp-3">
            <%= movie.overview %>
          </p>
          <p class="text-sm text-muted mt-2">
            <% if (todaysdate < new Date(movie.release_date)){ %>
              Coming soon..
            <% } else { %>
              Released on: <span class="font-bold"><%=movie.release_date%></span>
            <% } %>
          </p>
        </div>
      </div>

    </div>
  </a>
  <% }); %>

</div>


<%}%>

<div id="toastContainer" class="fixed bottom-6 right-30 z-50 flex flex-col gap-2"></div>
 <script>
     let asis = document.getElementById("asis");
                let asisbox = document.getElementById("asisbox");
                let asisClose = document.getElementById("asisClose");
                let prof = document.getElementById("prof");
                let probtn = document.getElementById("profbtn");
                const themeToggle = document.getElementById('themeToggle');
          asis.onclick = function(e){
  e.stopPropagation();
  asisbox.classList.toggle("hidden");
}

if (asisClose) {
  asisClose.onclick = function(e) {
    e.stopPropagation();
    asisbox.classList.add("hidden");
  }
}

if (probtn) {
  probtn.onclick = function(e){
    e.stopPropagation();
    prof.classList.toggle("hidden");
  }
}

document.addEventListener('click', (e) => {
  if (asisbox && !asisbox.contains(e.target)) {
    asisbox.classList.add('hidden');
  }
  if (prof && !prof.contains(e.target)) {
    prof.classList.add('hidden');
  }
});


if (localStorage.getItem('theme') === 'light') {
  document.documentElement.classList.add('light');
}

themeToggle.onclick = function() {
  document.documentElement.classList.toggle('light');
  localStorage.setItem('theme', document.documentElement.classList.contains('light') ? 'light' : 'dark');
  showToast('Theme changed!');
};
function showToast(message) {
  const container = document.getElementById('toastContainer');
  const toast = document.createElement('div');
  toast.textContent = message;
  toast.className = "bg-surface border border-border text-text px-4 py-2 rounded-lg";
  container.appendChild(toast);
  setTimeout(() => toast.remove(), 2000);
}
lucide.createIcons();
                </script>
</body>
