        </a>

        <div class="flex flex-wrap gap-2 mt-3">
          <% d.genres.forEach(function(g){ %>
            <a href="/gsearch/<%= g.id %>">
              <div class="px-3 py-1 rounded-full bg-surface border border-border hover:border-purple-600 transition">
                <span class="font-semibold text-sm"><%= g.name %></span>
              </div>
            </a>
          <% }) %>
        </div>

        <h1 class="text-center font-bold underline mt-4">Leading Actors</h1>

        <ul class="flex flex-col gap-2">
          <% e.slice(0,5).forEach(function(c){ %>
            <li class="flex items-center gap-3 rounded-lg border border-border bg-surface/50 p-3">
              <img class="h-12 w-12 rounded-lg object-cover"
                src="https://image.tmdb.org/t/p/w185<%= c.profile_path %>">

              <div>
                <h3 class="font-semibold"><%= c.name %></h3>
                <p class="text-sm text-muted"><%= c.character %></p>
              </div>
            </li>
          <% }) %>
        </ul>

        <h1 class="text-center font-bold underline mt-4">Crew</h1>

        <% f.slice(0,5).forEach(function(c){ %>
          <div class="rounded-lg border border-border bg-surface/50 p-2">
            <span class="font-bold text-danger"><%= c.name %></span>
            -
            <span class="font-semibold"><%= c.job %></span>
          </div>
        <% }) %>

      </div>

      <div class="w-full lg:flex-1 flex justify-center items-start">
        <div class="w-full aspect-video lg:max-w-xl">
          <div class="rounded-lg bg-surface/60 p-2 mb-2">
            <h1 class="text-center italic font-bold"><%= d.tagline %></h1>
          </div>

          <% if(t.results.length > 0){ %>
            <iframe
              class="w-full h-full rounded-xl"
              src="https://www.youtube.com/embed/<%= t.results[0].key %>">
            </iframe>
          <% } else { %>
            <img
              class="w-full rounded-xl"
              src="/public/gifs/trailer_not_available.gif">
          <% } %>
        </div>
      </div>

    </div>

    <div class="mt-6 rounded-xl border border-border bg-surface/70 p-4">
      <p class="text-sm md:text-lg text-center italic leading-7">
        <%= d.overview %>
      </p>
    </div>

  </div>
</div>
        


        </div>
        <h1 class="text-text font-bold text-3xl md:text-4xl text-center tracking-tight italic mt-3 mb-6  border-b-2 border-purple-600/50">Movies similar to this</h1>
        
         
            <div id="carousel" class="flex flex-nowrap gap-6  overflow-x-auto scroll-smooth snap-x snap-mandatory px-5 py-5 hide-scrollbar">

  <% x.forEach(function(movie){ %>
  <a href="/mdetails/<%=movie.id%>" class="group relative block overflow-hidden rounded-xl border border-border bg-surface w-80 h-96 shrink-0 snap-start">

    <% if(movie.poster_path){ %>
    <img
      alt="<%= movie.title %>"
      src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>"
      class="absolute inset-0 h-full w-full object-cover opacity-80 transition-all duration-300 group-hover:opacity-40 group-hover:scale-105"
    />
    <% } else { %>
    <img
      alt="<%= movie.title %>"
      src="/images/pngtree-no-image-available-icon-flatvector-illustration-pic-design-profile-vector-png-image_40966566.jpg"
      class="absolute inset-0 h-full w-full object-cover opacity-80 transition-all duration-300 group-hover:opacity-40 group-hover:scale-105"
    />
    <% } %>

    <div class="relative p-4 sm:p-6 lg:p-8">

      <p class="text-sm font-medium tracking-widest uppercase text-accent">
        <% if(movie.vote_average == 0){ %>Not Rated yet<% } else { %>⭐ <%=movie.vote_average.toFixed(1)%><% } %>
      </p>

      <p class="text-xl font-bold text-text sm:text-2xl italic">
        <%= movie.title %>
      </p>

      <div class="mt-32 sm:mt-20 lg:mt-24">
        <div class="translate-y-8 opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
          <p class="text-sm text-muted line-clamp-3">
            <%= movie.overview %>
          </p>
          <p class="text-sm text-muted mt-2">
            <% if (todaysdate < new Date(movie.release_date)){ %>
              Coming soon..
            <% } else { %>
              Released on: <span class="font-bold"><%=movie.release_date%></span>
            <% } %>
          </p>
        </div>
      </div>

    </div>
  </a>
  <% }); %>

</div>
                
<div id="toastContainer" class="fixed bottom-6 right-30 z-50 flex flex-col gap-2"></div>
                 <script>
                    const carousel = document.getElementById("carousel");
                    setInterval(() => {
    if (carousel.scrollLeft >= carousel.scrollWidth - carousel.clientWidth) {
        carousel.scrollLeft = 0;
    } else {
        carousel.scrollLeft += 320;
    }
}, 3000);
          let asis = document.getElementById("asis");
                let asisbox = document.getElementById("asisbox");
                let prof = document.getElementById("prof");
                let probtn = document.getElementById("profbtn");
                const themeToggle = document.getElementById('themeToggle');
          asis.onclick = function(e){
  e.stopPropagation();
  asisbox.classList.toggle("hidden");
}

if (probtn) {
  probtn.onclick = function(e){
    e.stopPropagation();
    prof.classList.toggle("hidden");
  }
}

document.addEventListener('click', (e) => {
  if (asisbox && !asisbox.contains(e.target)) {
    asisbox.classList.add('hidden');
  }
  if (prof && !prof.contains(e.target)) {
    prof.classList.add('hidden');
  }
});


if (localStorage.getItem('theme') === 'light') {
  document.documentElement.classList.add('light');
}

themeToggle.onclick = function() {
  document.documentElement.classList.toggle('light');
  localStorage.setItem('theme', document.documentElement.classList.contains('light') ? 'light' : 'dark');
  showToast('Theme changed!');
};
function showToast(message) {
  const container = document.getElementById('toastContainer');
  const toast = document.createElement('div');
  toast.textContent = message;
  toast.className = "bg-surface border border-border text-text px-4 py-2 rounded-lg";
  container.appendChild(toast);
  setTimeout(() => toast.remove(), 2000);
}
                </script>
                </body>


