      <h1 class="font-extrabold italic text-text text-5xl text-center "><%=d.title%></h1>
    <div class="flex justify-center px-3 mt-5">
  <% if(d.backdrop_path){ %>
    <div class="w-full bg-surface border border-border rounded-xl p-3 overflow-hidden"
      style="background-image:url('https://image.tmdb.org/t/p/original<%= d.backdrop_path %>');background-position:center;background-size:cover;">
  <% } else { %>
    <div class="w-full bg-surface border border-border rounded-xl p-3 overflow-hidden"
      style="background-image:url('https://img.magnific.com/free-photo/abstract-textured-backgound_1258-30495.jpg?semt=ais_hybrid&w=740&q=80');background-position:center;background-size:cover;">
  <% } %>

    <div class="flex flex-col lg:flex-row gap-6">

      <% if(d.poster_path){ %>
        <img
          class="w-48 sm:w-60 md:w-72 lg:w-1/4 mx-auto lg:mx-0 rounded-xl border border-border object-cover"
          src="https://image.tmdb.org/t/p/original<%= d.poster_path %>">
      <% } else { %>
        <img
          class="w-48 sm:w-60 md:w-72 lg:w-1/4 mx-auto lg:mx-0 rounded-xl border border-border object-cover"
          src="/images/pngtree-no-image-available-icon-flatvector-illustration-pic-design-profile-vector-png-image_40966566.jpg">
      <% } %>

      <div class="flex-1 flex flex-col gap-3 p-4 md:p-8 rounded-xl border border-border bg-surface/70">

        <% if(todaysdate < new Date(d.release_date)){ %>
          <h1 class="font-bold text-sm md:text-base">
            Release Status:
            <span class="text-lg md:text-2xl font-extrabold px-2">Coming Soon</span>
          </h1>
        <% } else { %>
          <h1 class="font-bold text-sm md:text-base">
            Released:
            <span class="text-lg md:text-2xl font-extrabold px-2"><%= d.release_date %></span>
          </h1>
        <% } %>

        <% if(d.vote_average == 0){ %>
          <h1 class="font-bold text-sm md:text-base">
            Rating:
            <span class="text-lg md:text-2xl font-extrabold px-2">Not Rated</span>
          </h1>
        <% } else { %>
          <h1 class="font-bold text-sm md:text-base">
            Rating:
            <span class="text-lg md:text-2xl font-extrabold px-2">⭐ <%= d.vote_average.toFixed(1) %>/10</span>
          </h1>
        <% } %>

        <h1 class="font-bold text-sm md:text-base">
          Status:
          <span class="text-lg md:text-2xl font-extrabold px-2"><%= d.status %></span>
        </h1>

        <h1 class="font-bold text-sm md:text-base">
          Runtime:
          <span class="text-lg md:text-2xl font-extrabold px-2"><%= d.runtime %> mins</span>
        </h1>

        <% if(d.budget < 10){ %>
          <h1 class="font-bold text-sm md:text-base">
            Budget:
            <span class="text-lg md:text-2xl font-extrabold px-2">Not Available</span>
          </h1>
        <% } else { %>
          <h1 class="font-bold text-sm md:text-base">
            Budget:
            <span class="text-lg md:text-2xl font-extrabold px-2">$<%= d.budget %></span>
          </h1>
        <% } %>

        <% if(d.revenue < 10){ %>
          <h1 class="font-bold text-sm md:text-base">
            Revenue:
            <span class="text-lg md:text-2xl font-extrabold px-2">Not Available</span>
          </h1>
        <% } else { %>
          <h1 class="font-bold text-sm md:text-base">
            Revenue:
            <span class="text-lg md:text-2xl font-extrabold px-2">$<%= d.revenue %></span>
          </h1>
        <% } %>

