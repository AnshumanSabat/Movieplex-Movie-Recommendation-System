<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MoviePlex</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

<link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" />
    
    <style type="text/tailwindcss">
@theme {
    --color-page: #0D1117;
    --color-surface: #161B22;
    --color-hover: #21262D;
    --color-border: #30363D;
    --color-accent: #2F81F7;
    --color-accent-hover: #1F6FEB;
    --color-text: #E6EDF3;
    --color-muted: #8B949E;
    --color-subtle: #6E7681;
    --color-done: #3FB950;
    --color-danger: #F85149;
    --color-pin: #E3B341;
    --color-pin-hover: #D29922;
    --color-show: #58A6FF;
    --color-show-hover: #79C0FF;
}
.light {
    --color-page: #F7F8FA;
    --color-surface: #FFFFFF;
    --color-hover: #EDEFF2;
    --color-border: #D8DCE2;
    --color-text: #0D1117;
    --color-muted: #57606A;
    --color-subtle: #6E7681;
    --color-done: #1A7F37;
    --color-danger: #CF222E;
    --color-pin: #9A6700;
    --color-pin-hover: #7A5200;
    --color-show: #0969DA;
    --color-show-hover: #0550AE;
}
</style>
<style>
.hide-scrollbar::-webkit-scrollbar{
    display:none;
}

.hide-scrollbar{
    -ms-overflow-style:none;
    scrollbar-width:none;
}
    </style>
</head>
<body class="min-h-screen bg-page text-text ">

    
