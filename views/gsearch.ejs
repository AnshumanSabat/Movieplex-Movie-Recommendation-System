        <path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path>
        <path d="M9 4v16"></path>
        <path d="M14 10l2 2l-2 2"></path>
      </svg>
    </label>

    <a href="/" class="flex items-center gap-3">
      <img class="rounded-lg w-12 h-12 object-cover object-center" src="/gifs/screen_hive_loader.gif">
      <h1 class="text-lg font-semibold tracking-tight text-text">Movieplex</h1>
    </a>

    <div class="flex-1 flex justify-center px-8">
  <form action="/search" method="GET" class="w-full max-w-md relative">
    <input type="text" placeholder="Search movies, shows..." name="q"
      class="w-full px-4 py-2 pr-10 rounded-full bg-page border border-border text-text text-sm placeholder-subtle focus:outline-none focus:border-purple-600 focus:ring-1 focus:ring-purple-600 transition-colors">
    <button type="submit" class="absolute right-1 top-1/2 -translate-y-1/2 p-1.5 rounded-full hover:bg-purple-600/20 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="size-4 text-purple-600">
        <circle cx="10" cy="10" r="7"></circle>
        <path d="M21 21l-6 -6"></path>
      </svg>
    </button>
  </form>
</div>

    <% if(user){ %>
