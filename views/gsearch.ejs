<body class="min-h-screen bg-page text-text ">

    
   <div class="relative min-h-screen bg-page text-text">
  <input id="my-drawer-4" type="checkbox" class="peer hidden" />

  <nav class="sticky left-0 right-0 top-0 z-70 flex items-center gap-4 px-4 py-2 bg-surface border-b border-border w-full">
    <label for="my-drawer-4" aria-label="open sidebar" class="cursor-pointer border rounded-lg border-border p-2 hover:bg-hover transition-all">
