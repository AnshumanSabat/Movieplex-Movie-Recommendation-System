<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MoviePlex</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

<link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" />
    
    <style type="text/tailwindcss">
@theme {
    --color-page: #0D1117;
    --color-surface: #161B22;
    --color-hover: #21262D;
    --color-border: #30363D;
    --color-accent: #2F81F7;
    --color-accent-hover: #1F6FEB;
    --color-text: #E6EDF3;
    --color-muted: #8B949E;
    --color-subtle: #6E7681;
    --color-done: #3FB950;
    --color-danger: #F85149;
    --color-pin: #E3B341;
    --color-pin-hover: #D29922;
    --color-show: #58A6FF;
    --color-show-hover: #79C0FF;
}
.light {
    --color-page: #F7F8FA;
    --color-surface: #FFFFFF;
    --color-hover: #EDEFF2;
    --color-border: #D8DCE2;
    --color-text: #0D1117;
    --color-muted: #57606A;
    --color-subtle: #6E7681;
    --color-done: #1A7F37;
    --color-danger: #CF222E;
    --color-pin: #9A6700;
    --color-pin-hover: #7A5200;
    --color-show: #0969DA;
    --color-show-hover: #0550AE;
}
</style>
<style>
.hide-scrollbar::-webkit-scrollbar{
    display:none;
}

.hide-scrollbar{
    -ms-overflow-style:none;
    scrollbar-width:none;
}
    </style>
</head>
<body class="min-h-screen bg-page text-text ">

    
   <div class="relative min-h-screen bg-page text-text">
  <input id="my-drawer-4" type="checkbox" class="peer hidden" />

  
  <nav class="sticky left-0 right-0 top-0 z-70 flex items-center gap-4 px-4 py-2 bg-surface border-b border-border w-full">
    <label for="my-drawer-4" aria-label="open sidebar" class="cursor-pointer border rounded-lg border-border p-2 hover:bg-hover transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="size-5 text-purple-600">
        <path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path>
        <path d="M9 4v16"></path>
        <path d="M14 10l2 2l-2 2"></path>
      </svg>
    </label>

    <a href="/" class="flex items-center gap-3">
      <img class="rounded-lg w-12 h-12 object-cover object-center" src="/gifs/screen_hive_loader.gif">
      <h1 class="text-lg font-semibold tracking-tight text-text">Movieplex</h1>
    </a>

    <div class="flex-1 flex justify-center px-8">
  <form action="/search" method="GET" class="w-full max-w-md relative">
    <input type="text" placeholder="Search movies, shows..." name="q"
      class="w-full px-4 py-2 pr-10 rounded-full bg-page border border-border text-text text-sm placeholder-subtle focus:outline-none focus:border-purple-600 focus:ring-1 focus:ring-purple-600 transition-colors">
    <button type="submit" class="absolute right-1 top-1/2 -translate-y-1/2 p-1.5 rounded-full hover:bg-purple-600/20 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="size-4 text-purple-600">
        <circle cx="10" cy="10" r="7"></circle>
        <path d="M21 21l-6 -6"></path>
      </svg>
    </button>
  </form>
</div>

    <% if(user){ %>
      <% if(user.image){ %>
        <img src="<%= user.image %>" class="outline outline-green-600 h-10 w-10 rounded-full object-cover">
      <% } else { %>
        <img src="/images/default-avatar.png" class="outline outline-green-600 h-10 w-10 rounded-full object-cover">
      <% } %>
    <% } else { %>
      <a href="/login" class="px-4 py-2 rounded-lg text-sm font-medium text-muted hover:bg-purple-600 hover:text-text transition-colors duration-150">login</a>
    <% } %>
  </nav>


   <label for="my-drawer-4" class="fixed inset-0 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none peer-checked:opacity-100 peer-checked:pointer-events-auto transition-opacity duration-300 z-40"></label>

<div class="fixed left-0 top-0 z-50 h-full w-64 -translate-x-full peer-checked:translate-x-0 transition-transform duration-300 ease-in-out bg-surface border-r border-border flex flex-col shadow-2xl">
  <ul class="menu w-full grow p-3 mt-20 gap-1">
    
    <li>
      <a href="/" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-semibold text-text/90 hover:bg-purple-600/15 hover:text-purple-400 transition-all duration-200">
        <span class="text-lg">🏠</span> <span>Home</span>
      </a>
    </li>
    <li>
      <a href="/watchlist" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-semibold text-text/90 hover:bg-purple-600/15 hover:text-purple-400 transition-all duration-200">
        <span class="text-lg">✨</span> <span>Watchlist</span>
      </a>
    </li>
    <li>
      <button id="themeToggle" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl font-semibold text-text/90 hover:bg-purple-600/15 hover:text-purple-400 transition-all duration-200">
        <span class="text-lg">🌗</span> <span>Theme</span>
      </button>
    </li>
    <li>
      <a href="/settings" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-semibold text-text/90 hover:bg-purple-600/15 hover:text-purple-400 transition-all duration-200">
        <span class="text-lg">⚙️</span> <span>Settings</span>
      </a>
    </li>
    <li>
      <a href="/help" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-semibold text-text/90 hover:bg-purple-600/15 hover:text-purple-400 transition-all duration-200">
        <span class="text-lg">❓</span> <span>Help</span>
      </a>
    </li>
  </ul>

  <div class="p-3 border-t border-border">
    <%if(user){%>
      <% if(user.image){ %>
        
           <img src="<%= user.image %>" class="outline outline-green-600 h-10 w-10 rounded-full object-cover">
        <span class="text-text font-bold text-md tracking-tighter"><%=user.name || user.username%></span>
        
       
      <% } else { %>
        
          <img src="/images/default-avatar.png" class="outline outline-green-600 h-10 w-10 rounded-full object-cover">
          <span class="text-text font-bold text-md tracking-tighter"><%=user.name || user.username%></span>
          
        
      <% } %>

      <a href="/logout" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-semibold text-danger hover:bg-danger/15 transition-all duration-200">
      <span class="text-lg">🚪</span> <span>Logout</span>
    </a>
      <%}else{%>
        <a href="/login" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-semibold text-blue-600 hover:bg-blue-400 transition-all duration-200">
      <span class="text-lg">🚪</span> <span>Login</span>
    </a>
       <%}%>
    
  </div>
</div>
      <button id="asis" class="fixed bottom-6 right-6 z-40 rounded-full hover:scale-150 transition-all duration-300">
  <img src="/gifs/ai_assistant_clapper_purple.gif" class="object-center rounded-full h-20 w-20">
</button>

<% if(product){ %>
<div id="asisbox" class="flex flex-col fixed top-20 right-4 bottom-40 z-50 bg-surface w-full max-w-md md:max-w-md outline outline-2 outline-purple-600 border border-border rounded-2xl shadow-2xl overflow-hidden">
<% } else { %>
<div id="asisbox" class="flex flex-col fixed top-20 right-4 bottom-40 z-50 bg-surface w-full max-w-md md:max-w-md outline outline-2 outline-purple-600 border border-border rounded-2xl shadow-2xl overflow-hidden hidden">
<% } %>

    <div class="px-4 py-3 border-b border-border">
        <h1 class="text-text font-bold text-xl text-center tracking-tight italic">Moxie</h1>
    </div>

    <% if(user){ %>
      <p class="font-bold text-center text-text/70 text-sm">welcome, <%=user.username || user.name%>👋</p>
    <% } %>

    <div class="flex-1 overflow-y-auto text-center px-4 py-3 space-y-2">
        <% if(product){ %>
            <p class="font-bold text-text text-lg tracking-tight px-2"><%- product %></p>
        <% } else { %>
            <p class="font-medium text-text/70 text-sm tracking-tight">speak your mind lil bro</p>
        <% } %>
    </div>

    <div class="flex items-center gap-2 px-3 py-3 border-t border-border">
        <form class="flex flex-1 gap-2" method="post" action="/ai">
            <input name="aiwaladata" class="px-4 py-2 flex-1 min-w-0 bg-transparent outline outline-1 outline-border focus:outline-purple-600 border border-border rounded-lg text-sm placeholder:text-text/40" placeholder="Likho balak">
            <button type="submit" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition-colors">Send</button>
        </form>
        <form method="post" action="/clear">
            <button type="submit" class="px-4 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white text-sm font-medium transition-colors">Clear</button>
        </form>
    </div>
</div>
    <h1 class="text-text font-bold text-3xl md:text-4xl text-center tracking-tight italic pb-4 border-b-2 border-purple-600/50">
  <span class="inline-flex items-center gap-2">
    <img src="/gifs/gear.gif" class="w-10 h-10 object-cover">
    Settings
  </span>
</h1>

<button id="test1" class="fixed top-1/2 left-2 rounded-full hover:scale-150 transition-all duration-300 hover:border-purple-600 text-xl">❯</button>
<div id="menu" class="-translate-x-full transition-transform duration-300 ease flex flex-col fixed top-40 left-0 bottom-40 z-40 bg-surface w-full max-w-sm md:max-w-sm border border-border rounded-xl">
  <button id="test2" class="fixed top-50 bottom-45 right-2 z-50 rounded-full hover:scale-150 transition-all duration-300 text-xl">❰</button>
</div>

<div class="max-w-2xl mx-auto px-4 py-10 space-y-6">

  <h1 class="text-text font-bold text-2xl md:text-3xl tracking-tight italic border-b-2 border-purple-600/50 pb-2">Account Details</h1>

  <div class="flex flex-col items-center gap-3 border border-border rounded-xl bg-surface p-8">
    <% if(user.image){ %>
      <img src="<%= user.image %>" class="outline outline-2 outline-green-600 h-28 w-28 rounded-full object-cover">
    <% } else { %>
      <img src="/images/default-avatar.png" class="outline outline-2 outline-green-600 h-28 w-28 rounded-full object-cover">
    <% } %>

    <% if(user.name || user.username){ %>
      <h2 class="text-2xl font-bold text-text"><%= user.name || user.username %></h2>
    <% } %>
  </div>

  <div class="border border-border rounded-xl bg-surface divide-y divide-border">
    <h2 class="text-text font-bold text-xl tracking-tight italic px-5 py-4">Personal Information</h2>

    <% if(user.name){ %>
      <div class="flex items-center justify-between px-5 py-3">
        <span class="text-muted font-medium">Name</span>
        <span class="text-text font-semibold"><%= user.name %></span>
      </div>
    <% } %>

    <div class="flex items-center justify-between px-5 py-3">
      <span class="text-muted font-medium">Username</span>
      <span class="text-text font-semibold"><%= user.username %></span>
    </div>

    <% if(user.email){ %>
      <div class="flex items-center justify-between px-5 py-3">
        <span class="text-muted font-medium">Email</span>
        <span class="text-text font-semibold"><%= user.email %></span>
      </div>
    <% } %>

    <% if(user.age){ %>
      <div class="flex items-center justify-between px-5 py-3">
        <span class="text-muted font-medium">Age</span>
        <span class="text-text font-semibold"><%= user.age %></span>
      </div>
    <% } %>
  </div>

  <div class="border border-border rounded-xl bg-surface">
    <h2 class="text-text font-bold text-xl tracking-tight italic px-5 py-4 border-b border-border">Security</h2>
    
     <div class="px-5 py-4 rounded-lg hover:bg-orange-700 transition-all duration-200">
      <a href="/cpassword" class="cursor-pointer w-full inline-flex items-center gap-2 text-sm font-medium text-pin hover:text-pin-hover transition-colors">
        <span class="text-lg">🔏 Change Password</span>
      </a>
    </div>
   
  </div>


  
  <div class="border border-border rounded-xl bg-surface">
    <h2 class="text-text font-bold text-xl tracking-tight italic px-5 py-4 border-b border-border">Appearance</h2>
    <div class="px-5 py-4 rounded-lg hover:bg-cyan-400 transition-all duration-200">
      <a id="themeToggle2" class="cursor-pointer w-full inline-flex items-center gap-2 text-sm font-medium text-blue-600 hover:text-text transition-colors">
        <span class="text-lg">🌗</span> <span>Theme</span>
      </a>
    </div>
  </div>

</div>






















<div id="toastContainer" class="fixed bottom-6 right-30 z-50 flex flex-col gap-2"></div>
          <script>
  let asis = document.getElementById("asis");
                let asisbox = document.getElementById("asisbox");
                let prof = document.getElementById("prof");
                let probtn = document.getElementById("profbtn");
                let test1 = document.getElementById("test1");
                let test2 = document.getElementById("test2");
                let menu = document.getElementById("menu");
                const themeToggle = document.getElementById('themeToggle');
                  const themeToggle2 = document.getElementById('themeToggle2');
test1.addEventListener("click", () => {
    menu.classList.toggle("-translate-x-full");
    menu.classList.toggle("translate-x-0");
});
test2.addEventListener("click", (e) => {
    e.stopPropagation();
    menu.classList.toggle("-translate-x-full");
    menu.classList.toggle("translate-x-0");
});



          asis.onclick = function(e){
  e.stopPropagation();
  asisbox.classList.toggle("hidden");
}

if (probtn) {
  probtn.onclick = function(e){
    e.stopPropagation();
    prof.classList.toggle("hidden");
  }
}

document.addEventListener('click', (e) => {
  if (!asisbox.contains(e.target)) {
    asisbox.classList.add('hidden');
  }
  if (!prof.contains(e.target)) {
    prof.classList.add('hidden');
  }
  if (!menu.contains(e.target) && e.target !== test1) {
    menu.classList.add("-translate-x-full");
    menu.classList.remove("translate-x-0");
}
   
});


if (localStorage.getItem('theme') === 'light') {
  document.documentElement.classList.add('light');
}

themeToggle.onclick = function() {
  document.documentElement.classList.toggle('light');
  localStorage.setItem('theme', document.documentElement.classList.contains('light') ? 'light' : 'dark');
  showToast('Theme changed!');
};

themeToggle2.onclick = function() {
  document.documentElement.classList.toggle('light');
  localStorage.setItem('theme', document.documentElement.classList.contains('light') ? 'light' : 'dark');
  showToast('Theme changed!');
};
function showToast(message) {
  const container = document.getElementById('toastContainer');
  const toast = document.createElement('div');
  toast.textContent = message;
  toast.className = "bg-surface border border-border text-text px-4 py-2 rounded-lg";
  container.appendChild(toast);
  setTimeout(() => toast.remove(), 2000);
}
</script>
</body>
</html>
