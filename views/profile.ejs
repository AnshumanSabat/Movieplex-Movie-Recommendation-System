<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MoviePlex</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <style type="text/tailwindcss">
@theme {
    --color-page: #0D1117;
    --color-surface: #161B22;
    --color-hover: #21262D;
    --color-border: #30363D;
    --color-accent: #2F81F7;
    --color-accent-hover: #1F6FEB;
    --color-text: #E6EDF3;
    --color-muted: #8B949E;
    --color-subtle: #6E7681;
    --color-done: #3FB950;
    --color-danger: #F85149;
    --color-pin: #E3B341;
    --color-pin-hover: #D29922;
    --color-show: #58A6FF;
    --color-show-hover: #79C0FF;
}
.light {
    --color-page: #F7F8FA;
    --color-surface: #FFFFFF;
    --color-hover: #EDEFF2;
    --color-border: #D8DCE2;
    --color-text: #0D1117;
    --color-muted: #57606A;
    --color-subtle: #6E7681;
    --color-done: #1A7F37;
    --color-danger: #CF222E;
    --color-pin: #9A6700;
    --color-pin-hover: #7A5200;
    --color-show: #0969DA;
    --color-show-hover: #0550AE;
}
    </style>
</head>
<body class="min-h-screen bg-page text-text ">
       

    
    <nav class="flex justify-between items-center px-8 py-2 bg-surface border-b border-border w-full ">
        <div class="flex items-center gap-3">
          <a href="/"><img class=" rounded-lg w-15 h-15 object-cover object-centers" src="/gifs/screen_hive_loader.gif"></a>
            <h1 class="text-lg font-semibold tracking-tight text-text">Movieplex</h1>
        </div>
        <div class="flex gap-1">
            <%if(user){%>
              <div class="">
                    <%if(user.image){%>
                    <img src="<%= user.image %>" class="outline outline-green-600 h-10 w-10 rounded-full object-cover">
                    <%}else{%>
                    <img src="/images/default-avatar.png" class=" outline outline-green-600 h-10 w-10 rounded-full object-cover">
                    <%}%>

                    <div id="prof" class="overflow-hidden hidden fixed right-1 top-20 z-50 flex flex-col bg-surface min-w-44 border border-border shadow-xl rounded-xl p-1 gap-0.5">
                        <a href="/profile" class="flex items-center gap-2.5 px-3 py-2 rounded-lg font-medium text-sm text-text hover:bg-purple-600/15 hover:text-purple-400 transition-colors">
                          <i data-lucide="user" class="size-4"></i> Profile
                        </a>
                        <a href="/" class="flex items-center gap-2.5 px-3 py-2 rounded-lg font-medium text-sm text-text hover:bg-purple-600/15 hover:text-purple-400 transition-colors">
                          <i data-lucide="house" class="size-4"></i> Home
                        </a>
                        <a href="/watchlist" class="flex items-center gap-2.5 px-3 py-2 rounded-lg font-medium text-sm text-text hover:bg-purple-600/15 hover:text-purple-400 transition-colors">
                          <i data-lucide="bookmark" class="size-4"></i> Watchlist
                        </a>
                        <button id="themeToggle" class="w-full flex items-center gap-2.5 px-3 py-2 rounded-lg font-medium text-sm text-text hover:bg-purple-600/15 hover:text-purple-400 transition-colors text-left">
                          <i data-lucide="sun-moon" class="size-4"></i> Theme
                        </button>
                        <a href="/settings" class="flex items-center gap-2.5 px-3 py-2 rounded-lg font-medium text-sm text-text hover:bg-purple-600/15 hover:text-purple-400 transition-colors">
                          <i data-lucide="settings" class="size-4"></i> Settings
                        </a>
                        <a href="/help" class="flex items-center gap-2.5 px-3 py-2 rounded-lg font-medium text-sm text-text hover:bg-purple-600/15 hover:text-purple-400 transition-colors">
                          <i data-lucide="circle-help" class="size-4"></i> Help
                        </a>
                        <div class="my-1 border-t border-border"></div>
                        <a href="/logout" class="flex items-center gap-2.5 px-3 py-2 rounded-lg font-medium text-sm text-danger hover:bg-danger/15 transition-colors">
                          <i data-lucide="log-out" class="size-4"></i> Logout
                        </a>
                        <%}else{%>
                         <a href="/login" class="px-4 py-2 rounded-lg text-sm font-medium text-muted hover:bg-blue-600 hover:text-text transition-colors duration-150">login</a>
                        <%}%>
                        </div>
                    </div>
                     <button id="profbtn" class="border rounded-lg border-border flex flex-col gap-1.5 p-2 hover:scale-105 transition-all">
                       <span class="w-6 h-0.5 bg-purple-600"></span>
                       <span class="w-6 h-0.5 bg-purple-600"></span>
                       <span class="w-6 h-0.5 bg-purple-600"></span>
                    </button>
        </div>
    </nav>

<button id="asis" class="fixed bottom-6 right-6 z-40 rounded-full shadow-xl shadow-purple-900/40 hover:scale-110 transition-all duration-300 group">
  <img src="/gifs/ai_assistant_clapper_purple.gif" class="object-center rounded-full h-16 w-16 ring-2 ring-purple-600/60 group-hover:ring-purple-500 transition-all">
</button>

<%if(product){%>
<div id="asisbox" class="flex flex-col fixed top-16 right-4 bottom-28 z-50 bg-surface w-full max-w-sm border border-purple-600/40 rounded-2xl shadow-2xl shadow-purple-900/30 overflow-hidden transition-all duration-300">
<%}else{%>
<div id="asisbox" class="flex flex-col fixed top-16 right-4 bottom-28 z-50 bg-surface w-full max-w-sm border border-purple-600/40 rounded-2xl shadow-2xl shadow-purple-900/30 overflow-hidden transition-all duration-300 hidden">
<%}%>
  <div class="flex items-center justify-between px-4 py-3 bg-gradient-to-r from-purple-900/50 to-surface border-b border-purple-600/30">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-full bg-purple-600/20 flex items-center justify-center">
        <i data-lucide="bot" class="size-4 text-purple-400"></i>
      </div>
      <div>
        <h1 class="text-text font-bold text-sm tracking-tight">Moxie</h1>
        <p class="text-purple-400 text-xs">AI Movie Assistant</p>
      </div>
    </div>
    <button id="asisClose" class="p-1.5 rounded-lg hover:bg-border/50 transition-colors">
      <i data-lucide="x" class="size-4 text-muted"></i>
    </button>
  </div>
  <% if(user){ %>
    <p class="px-4 pt-2 text-xs text-purple-400 font-medium">welcome, <%=user.username || user.name%> 👋</p>
  <% } %>
  <div class="flex-1 overflow-y-auto px-4 py-4 space-y-3">
    <% if(product){ %>
      <div class="bg-purple-600/10 border border-purple-600/20 rounded-xl p-3">
        <div class="flex items-start gap-2 mb-2">
          <div class="w-6 h-6 rounded-full bg-purple-600/30 flex items-center justify-center shrink-0 mt-0.5">
            <i data-lucide="sparkles" class="size-3 text-purple-400"></i>
          </div>
          <span class="text-xs font-semibold text-purple-400">Moxie</span>
        </div>
        <div class="text-text text-sm leading-relaxed pl-8"><%- product %></div>
      </div>
    <% } else { %>
      <div class="flex flex-col items-center justify-center h-full gap-3 py-8 text-center">
        <div class="w-14 h-14 rounded-full bg-purple-600/10 flex items-center justify-center">
          <i data-lucide="sparkles" class="size-7 text-purple-400/70"></i>
        </div>
        <p class="font-semibold text-text text-sm">Ask me anything about movies!</p>
        <p class="text-muted text-xs max-w-48">I can recommend films, suggest similar titles, and more.</p>
      </div>
    <% } %>
  </div>
  <div class="px-3 py-3 border-t border-border bg-surface/80 backdrop-blur-sm">
    <div class="flex items-center gap-2">
      <form class="flex flex-1 items-center gap-2 bg-page rounded-xl border border-border focus-within:border-purple-600 transition-colors overflow-hidden px-3 py-1.5" method="post" action="/ai">
        <i data-lucide="message-circle" class="size-4 text-muted shrink-0"></i>
        <input name="aiwaladata" class="flex-1 bg-transparent text-sm text-text placeholder:text-muted/60 focus:outline-none py-1" placeholder="Ask about movies...">
        <button type="submit" class="p-1.5 rounded-lg bg-purple-600 hover:bg-purple-700 text-white transition-colors shrink-0">
          <i data-lucide="send" class="size-3.5"></i>
        </button>
      </form>
      <form method="post" action="/clear">
        <button type="submit" title="Clear chat" class="p-2 rounded-xl border border-border hover:bg-danger/10 hover:border-danger/50 text-muted hover:text-danger transition-all">
          <i data-lucide="trash-2" class="size-4"></i>
        </button>
      </form>
    </div>
  </div>
</div>
    <h1 class="text-text font-bold text-3xl md:text-4xl text-center tracking-tight italic  mb-6 pb-3 border-b-2 border-purple-600/50">User Details</h1>
    <div class="flex justify-center items-center w-full mt-5 ">
        
           <div class=" flex flex-col h-full rounded-lg border border-border bg-surface/60 w-full max-w-xl">
            <%if(user.name){%>
            <h1 class="font-bold" >Name:<span class="text-danger text-3xl font-extrabold p-4"><%=user.name%></span></h1>
            <%}%>
            <h1 class="font-bold" >Username:<span class="text-danger text-3xl font-extrabold p-4"><%=user.username%></span></h1>
              <%if(user.email){%>
            <h1 class="font-bold" >Email:<span class="text-danger text-3xl font-extrabold p-4 "><%=user.email%></span></h1>
            <%}%>
             <%if(user.age){%>
           <h1 class="font-bold" >Age:<span class="text-danger text-3xl font-extrabold p-4"><%=user.age%></span></h1>
            <%}%>
            
            
            </div>

        </div>
        
<div id="toastContainer" class="fixed bottom-6 left-6 z-50 flex flex-col gap-2"></div>
           <script>
  let asis = document.getElementById("asis");
                let asisbox = document.getElementById("asisbox");
                let asisClose = document.getElementById("asisClose");
                let prof = document.getElementById("prof");
                let probtn = document.getElementById("profbtn");
                const themeToggle = document.getElementById('themeToggle');
          asis.onclick = function(e){
  e.stopPropagation();
  asisbox.classList.toggle("hidden");
}

if (asisClose) {
  asisClose.onclick = function(e) {
    e.stopPropagation();
    asisbox.classList.add("hidden");
  }
}

probtn.onclick = function(e){
  e.stopPropagation();
  prof.classList.toggle("hidden");
}

document.addEventListener('click', (e) => {
  if (asisbox && !asisbox.contains(e.target)) {
    asisbox.classList.add('hidden');
  }
  if (prof && !prof.contains(e.target)) {
    prof.classList.add('hidden');
  }
});


if (localStorage.getItem('theme') === 'light') {
  document.documentElement.classList.add('light');
}

themeToggle.onclick = function() {
  document.documentElement.classList.toggle('light');
  localStorage.setItem('theme', document.documentElement.classList.contains('light') ? 'light' : 'dark');
  showToast('Theme changed!');
};
function showToast(message) {
  const container = document.getElementById('toastContainer');
  const toast = document.createElement('div');
  toast.textContent = message;
  toast.className = "bg-surface border border-border text-text px-4 py-2 rounded-lg";
  container.appendChild(toast);
  setTimeout(() => toast.remove(), 2000);
}
lucide.createIcons();
                </script>

</body>
</html>
